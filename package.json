{
  "name": "finadelic",
  "version": "1.0.0",
  "description": "finance organizer tool for private purposes",
  "main": "./src/index.js",
  "scripts": {
    "build": "webpack --config webpack.config.js --mode development",
    "build:prod": "webpack --config webpack.config.prod.js --mode production",
    "sass": "sass ./style/main.scss ./dist/main.css --watch",
    "sass-in": "sass ./style/main.scss ./public/main_in.css --watch",
    "sass:prod": "sass ./style/main.scss ./public/wholeApp/main.css --style=compressed",
    "serve": "webpack-dev-server --hot",
    "start": "nodemon app.js",
    "autotest": "vitest",
    "test": "vitest --run --reporter verbose --environment happy-dom",
    "type-check": "tsc --noEmit -p tsconfig.frontend.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RayMacBart/FinaDelic.git"
  },
  "keywords": [
    "finance"
  ],
  "author": "Reinhard Höbart",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RayMacBart/FinaDelic/issues"
  },
  "homepage": "https://github.com/RayMacBart/FinaDelic#readme",
  "browserslist": "> 1%",
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.28.5",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^13.0.0",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "happy-dom": "^20.8.9",
    "html-webpack-plugin": "^5.6.4",
    "image-minimizer-webpack-plugin": "^4.1.4",
    "imagemin": "^9.0.1",
    "imagemin-jpegtran": "^8.0.0",
    "imagemin-mozjpeg": "^10.0.0",
    "nodemon": "^3.1.11",
    "purgecss": "^7.0.2",
    "sass": "^1.90.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4",
    "vscl": "^2.3.1",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@dr.pogodin/csurf": "^1.16.8",
    "argon2": "^0.44.0",
    "body-parser": "^2.2.2",
    "chart.js": "^4.5.1",
    "connect-mongo": "^6.0.0",
    "core-js": "^3.45.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "mongoose": "^9.1.5",
    "nodemailer": "^8.0.8",
    "regenerator-runtime": "^0.14.1"
  }
}
